# Copy to server/.env for local development.
DATABASE_URL=postgresql://localhost:5432/reveiller_books
PORT=3000
BUSINESS_TZ=America/Toronto
# Required in production: the code you type on first sign-in to create the owner account.
SETUP_TOKEN=change-me

# Shopify (optional). Use a Dev Dashboard app's client credentials...
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or a legacy custom app's Admin API token instead.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
